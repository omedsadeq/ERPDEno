# dentHisab — block web access to sensitive files
# Filesystem/PHP access is unaffected; this only blocks direct HTTP download.

# 1) Environment file (contains DB + S3 secret keys)
<Files ".env">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</Files>

# 2) Sensitive file types: DB dumps, archives, backups, docs, logs, VCS, deps
<FilesMatch "\.(sql|zip|tar|gz|bak|old|dist|log|sh|ini|md|lock)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# 3) Composer / package manifests
<FilesMatch "^(composer\.(json|lock)|package(-lock)?\.json|\.env\..*|\.git.*)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# 4) Stray dev artifacts left in the web root
<FilesMatch "^(nul|Edit|temp_output\.txt)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Do not expose directory listings
Options -Indexes

# ── Performance for LAN clients (added 2026-08-29) ────────────────────
# ~10 PCs load the same CSS/JS/font assets all day. Previously every one of
# them re-downloaded the lot on every page, uncompressed.

# 1) gzip text responses. style.css and the generated HTML for pages like
#    waiting-room.php are large and compress ~5-8x over the LAN.
<IfModule mod_deflate.c>
    <IfModule mod_filter.c>
        AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
        AddOutputFilterByType DEFLATE application/javascript application/x-javascript
        AddOutputFilterByType DEFLATE application/json application/xml
        AddOutputFilterByType DEFLATE image/svg+xml
    </IfModule>
    # Fonts and images are already compressed — re-zipping them just burns CPU.
    SetEnvIfNoCase Request_URI \.(?:woff2?|ttf|eot|png|jpe?g|gif|webp|ico|zip|rar|pdf)$ no-gzip dont-vary
</IfModule>

# 2) Let browsers keep static assets instead of refetching them every page.
#    NOTE: no ExpiresDefault on purpose. PHP responses must never be cached —
#    config.php sends "Cache-Control: no-store" for patient/payment data, and
#    an ExpiresDefault here would fight that. Only static types are listed.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css                "access plus 7 days"
    ExpiresByType application/javascript  "access plus 7 days"
    ExpiresByType image/png               "access plus 30 days"
    ExpiresByType image/jpeg              "access plus 30 days"
    ExpiresByType image/gif               "access plus 30 days"
    ExpiresByType image/webp              "access plus 30 days"
    ExpiresByType image/svg+xml           "access plus 30 days"
    ExpiresByType image/x-icon            "access plus 30 days"
    ExpiresByType font/woff               "access plus 1 year"
    ExpiresByType font/woff2              "access plus 1 year"
    ExpiresByType application/font-woff   "access plus 1 year"
</IfModule>

# 3) The service worker and manifest must stay fresh, or clients keep running
#    an old cached shell after an update and never see new code.
<FilesMatch "^(sw\.js|manifest\.json)$">
    <IfModule mod_expires.c>
        ExpiresActive Off
    </IfModule>
    <IfModule mod_headers.c>
        Header set Cache-Control "no-cache, must-revalidate"
    </IfModule>
</FilesMatch>

# ── Performance ────────────────────────────────────────────────────
# Static assets are versioned by deploy (sw.js CACHE_VERSION) and never
# contain patient data, so they can be cached hard by the browser. Dynamic
# PHP responses are untouched here — config.php sends no-store for those.

# 1) Long-lived caching for static assets.
<FilesMatch "\.(css|js|woff|woff2|ttf|eot|svg|png|jpg|jpeg|gif|webp|ico|mp3|wav)$">
    <IfModule mod_headers.c>
        Header set Cache-Control "public, max-age=31536000, immutable"
        Header unset Pragma
        Header unset Expires
    </IfModule>
    <IfModule mod_expires.c>
        ExpiresActive On
        ExpiresDefault "access plus 1 year"
    </IfModule>
</FilesMatch>

# The service worker and manifest must always be revalidated, otherwise a
# deploy can never reach a browser that already cached them.
<FilesMatch "^(sw\.js|manifest\.json)$">
    <IfModule mod_headers.c>
        Header set Cache-Control "no-cache, must-revalidate"
    </IfModule>
</FilesMatch>

# 2) Compression for static files. PHP output is compressed in config.php,
#    which covers hosts where mod_deflate is unavailable.
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml \
        text/javascript application/javascript application/json \
        application/xml application/xhtml+xml image/svg+xml \
        application/x-font-ttf font/opentype
    <IfModule mod_headers.c>
        Header append Vary Accept-Encoding
    </IfModule>
</IfModule>

# 5) Include-only files: header.php / sidebar.php / footer.php are meant to be
#    included by a page, and fatal with a path-revealing error if requested
#    directly. Block them at the door.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^includes/ - [F,L]
    RewriteRule ^templates/ - [F,L]
</IfModule>
