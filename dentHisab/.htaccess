# dentHisab — block web access to sensitive files
# Filesystem/PHP access is unaffected; this only blocks direct HTTP download.

# 1) Environment file (contains DB + S3 secret keys)
<Files ".env">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</Files>

# 2) Sensitive file types: DB dumps, archives, backups, docs, logs, VCS, deps
<FilesMatch "\.(sql|zip|tar|gz|bak|old|dist|log|sh|ini|md|lock)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# 3) Composer / package manifests
<FilesMatch "^(composer\.(json|lock)|package(-lock)?\.json|\.env\..*|\.git.*)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# 4) Stray dev artifacts left in the web root
<FilesMatch "^(nul|Edit|temp_output\.txt)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Do not expose directory listings
Options -Indexes
